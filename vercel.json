{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/corporate-invoices",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/document-alerts",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/subscription-alerts",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/quote-followup",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/auto-assign",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/compliance-alerts",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/quickbooks-sync",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/expire-referrals",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "https://luxeride.vercel.app" },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,DELETE,PATCH,POST,PUT"
        }
      ]
    }
  ]
}
