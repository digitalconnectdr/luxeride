EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://getluxeride.vercel.app

# Slug (companies.slug) de la empresa que este build de la app representa —
# esta primera versión apunta a UN operador (ver plan Sprint 0-1), no es
# multi-empresa dentro de la misma app. Debe ser una empresa con
# companies.status = 'active'.
EXPO_PUBLIC_COMPANY_SLUG=

# ── Google Maps SDK nativo (Sprint 2 — mapa en vivo) ───────────────────────
# NO son las mismas keys que usa apps/web (esas están restringidas por HTTP
# referrer/solo-API, no sirven aquí). El Maps SDK nativo necesita su propia
# key por plataforma, restringida por identidad de la app, no por referrer:
#
# Android — Google Cloud Console → APIs & Services → Credentials → Create
# Credentials → API Key → Restrict key:
#   - Application restriction: "Android apps"
#   - Package name: com.jprsdigitalconnect.luxeride.passenger
#   - SHA-1 certificate fingerprint: correr `eas credentials` en este
#     directorio (elige Android → View/manage credentials) tras el primer
#     `eas build`, ahí Expo muestra el SHA-1 del keystore que está firmando
#     el build.
#   - API restriction: "Maps SDK for Android"
# Sin esta key, el mapa simplemente no renderiza — el resto de la app
# (reservar, cotizar, autocomplete) funciona igual.
GOOGLE_MAPS_ANDROID_API_KEY=

# iOS (opcional, solo si en algún momento se agrega build de iOS) — mismo
# proceso pero "Application restriction: iOS apps" + Bundle ID.
GOOGLE_MAPS_IOS_API_KEY=
