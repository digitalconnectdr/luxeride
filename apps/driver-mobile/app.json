{
  "expo": {
    "name": "LuxeRide Conductor",
    "slug": "luxeride-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1d1b18",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jprsdigitalconnect.luxeride.driver",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.jprsdigitalconnect.luxeride.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1d1b18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LuxeRide usa tu ubicación mientras el viaje está activo para que el pasajero vea tu posición en el mapa en vivo.",
          "locationAlwaysAndWhenInUsePermission": "LuxeRide necesita ubicación en segundo plano para que el pasajero siga viendo tu posición aunque uses Waze o Google Maps durante el viaje.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e9c176"
        }
      ]
    ]
  }
}
