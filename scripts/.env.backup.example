# Copia este archivo a ".env.backup" (mismo folder) y pon tu cadena real.
# ".env.backup" está en .gitignore — nunca se sube a GitHub.
#
# Cómo conseguir la cadena real:
#   Supabase → tu proyecto (iwjtjwryhtpzuvwmlpjk) → Settings → Database
#   → Connection string → pestaña "URI" → copiar la de "Direct connection"
#   (puerto 5432, no el pooler) → reemplazar [YOUR-PASSWORD] por tu password real.

SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@TU_HOST:5432/postgres
